# Copy to .env on the VM: ~/vital-api/.env
# All values without defaults MUST be set before running docker compose up.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Public hostname or IP the browser uses to reach Keycloak (no port, no scheme)
KEYCLOAK_HOSTNAME=101.42.46.218
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_admin_password
KEYCLOAK_REALM=vital-signs
KEYCLOAK_CLIENT_ID=vital-web
KEYCLOAK_ADMIN_CLIENT_ID=vital-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change_me_client_secret

# ── SigNoz Cloud ──────────────────────────────────────────────────────────────
# Ingestion key from https://app.signoz.io → Settings → Ingestion Keys
SIGNOZ_INGESTION_KEY=change_me_signoz_ingestion_key
# OTLP endpoint for your SigNoz Cloud region (e.g. ingest.us.signoz.cloud:443)
SIGNOZ_OTLP_ENDPOINT=ingest.us.signoz.cloud:443

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-app-domain.com
